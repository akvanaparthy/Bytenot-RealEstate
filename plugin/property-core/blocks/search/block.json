{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "property-core/search",
	"title": "Property search",
	"category": "widgets",
	"icon": "search",
	"description": "Search form built from the agency's setup: property types, transactions, budget bands, configuration and localities. Submits to the property archive.",
	"textdomain": "property-core",
	"attributes": {
		"part": { "type": "string", "default": "form", "enum": [ "form", "tags" ] },
		"title": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "customClassName": true },
	"editorScript": "file:./index.js",
	"style": [ "property-core-fields", "file:./style.css" ],
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
