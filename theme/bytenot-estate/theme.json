{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1440px",
			"wideSize": "1520px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Contrast", "color": "#142f3f" },
				{ "slug": "contrast-hover", "name": "Contrast hover", "color": "#1d3f54" },
				{ "slug": "primary", "name": "Accent light", "color": "#f9ebb2" },
				{ "slug": "primary-hover", "name": "Accent light hover", "color": "#fbf1c7" },
				{ "slug": "primary-dark", "name": "Accent dark", "color": "#897749" },
				{ "slug": "ink", "name": "Ink", "color": "#142f3f" },
				{ "slug": "ink-soft", "name": "Ink soft", "color": "#3f5465" },
				{ "slug": "ink-muted", "name": "Ink muted", "color": "#6b7f8c" },
				{ "slug": "surface", "name": "Surface", "color": "#f3f6f7" },
				{ "slug": "input", "name": "Input", "color": "#f0f3f5" },
				{ "slug": "border", "name": "Border", "color": "#dfe6ea" },
				{ "slug": "glass", "name": "Glass", "color": "rgba(255, 255, 255, 0.22)" }
			],
			"gradients": [
				{ "slug": "brand-gold", "name": "Accent gradient", "gradient": "linear-gradient(135deg, #f9ebb2 0%, #897749 100%)" },
				{ "slug": "brand-gold-soft", "name": "Accent gradient, soft", "gradient": "linear-gradient(135deg, #f9ebb2 0%, #cdb97a 100%)" }
			]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Figtree",
					"fontFamily": "\"Figtree\", system-ui, -apple-system, \"Segoe UI\", \"Noto Sans\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Figtree", "fontWeight": "300 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Figtree", "fontWeight": "300 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
						{ "fontFamily": "Figtree", "fontWeight": "300 900", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-italic-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Figtree", "fontWeight": "300 900", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-italic-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Meta", "size": "13px" },
				{ "slug": "small", "name": "Small", "size": "15px" },
				{ "slug": "medium", "name": "Body", "size": "16px" },
				{ "slug": "lede", "name": "Lede", "size": "17px" },
				{ "slug": "large", "name": "Large", "size": "22px" },
				{ "slug": "x-large", "name": "Card title", "size": "clamp(26px, 2.18vw, 30px)" },
				{ "slug": "xx-large", "name": "Section title", "size": "clamp(34px, 4.06vw, 56px)" },
				{ "slug": "display", "name": "Display", "size": "clamp(42px, 5.22vw, 72px)" }
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [ "px", "rem", "em", "vh", "vw", "%" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "8px" },
				{ "slug": "30", "name": "2", "size": "12px" },
				{ "slug": "40", "name": "3", "size": "20px" },
				{ "slug": "50", "name": "4", "size": "40px" },
				{ "slug": "60", "name": "5", "size": "64px" },
				{ "slug": "70", "name": "6", "size": "110px" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "float", "name": "Float", "shadow": "0 12px 40px rgba(20, 47, 63, 0.14)" },
				{ "slug": "card", "name": "Card", "shadow": "0 30px 80px rgba(0, 0, 0, 0.25)" }
			]
		},
		"custom": {
			"radius": { "card": "24px", "input": "10px", "pill": "999px" },
			"shadow": { "float": "0 12px 40px rgba(20, 47, 63, 0.14)" },
			"hero": { "frame": "12px", "notchGap": "12px", "partnersHeight": "96px" },
			"layout": { "contentSize": "1440px", "gutter": "40px" },
			"header": { "height": "86px", "heightCompact": "72px", "piece": "56px" },
			"transition": "0.2s ease"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.5"
		}
	}
}
